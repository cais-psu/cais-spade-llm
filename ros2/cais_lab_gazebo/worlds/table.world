<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Gazebo ROS state plugin (provides /get_entity_state, /set_entity_state) -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
    </plugin>
    <!-- IFRA LinkAttacher world plugin (services: /ATTACHLINK, /DETACHLINK) -->
    <plugin name="gazebo_link_attacher" filename="libgazebo_link_attacher.so"/>
    <include>
      <uri>model://table</uri>
      <name>table_xarm6</name>
      <pose>0.0 0.40 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://table</uri>
      <name>table_ur5e</name>
      <pose>0.0 -0.40 0 0 0 0</pose>
    </include>

    <model name="assembly_board_v1">
      <static>true</static>
      <!-- Center on combined table top. Board: 0.35x0.3, 10mm thick. Top at z=1.025 -->
      <pose>0 0 1.02 0 0 0</pose>
      <link name="link">
        <!-- Single solid collision box for the entire board -->
        <collision name="collision">
          <geometry>
            <box>
              <size>0.35 0.3 0.01</size>
            </box>
          </geometry>
        </collision>

        <!-- ======== VISUALS ======== -->
        <!-- Single white top surface (clean, no segmented pieces) -->
        <visual name="visual_top">
          <geometry>
            <box>
              <size>0.35 0.3 0.01</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>

        <!-- Socket markers: black circles/squares on top surface showing slot positions.
             3x3 grid: x spacing 10cm, y spacing 8cm.
             Gear row y=0.08, Rect-pin row y=0.0, Circ-pin row y=-0.08 -->

        <!-- Gear sockets (y=0.08) -->
        <visual name="socket_SG">
          <pose>-0.10 0.08 0.006 0 0 0</pose>
          <geometry><cylinder><radius>0.019</radius><length>0.001</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <visual name="socket_MG">
          <pose>0.0 0.08 0.006 0 0 0</pose>
          <geometry><cylinder><radius>0.027</radius><length>0.001</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <visual name="socket_LG">
          <pose>0.10 0.08 0.006 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.001</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>

        <!-- Rect-pin sockets (y=0.0) -->
        <visual name="socket_SRP">
          <pose>-0.10 0.0 0.006 0 0 0</pose>
          <geometry><box><size>0.024 0.024 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <visual name="socket_MRP">
          <pose>0.0 0.0 0.006 0 0 0</pose>
          <geometry><box><size>0.029 0.029 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <visual name="socket_LRP">
          <pose>0.10 0.0 0.006 0 0 0</pose>
          <geometry><box><size>0.034 0.034 0.001</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>

        <!-- Circ-pin sockets (y=-0.08) -->
        <visual name="socket_SCP">
          <pose>-0.10 -0.08 0.006 0 0 0</pose>
          <geometry><cylinder><radius>0.013</radius><length>0.001</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <visual name="socket_MCP">
          <pose>0.0 -0.08 0.006 0 0 0</pose>
          <geometry><cylinder><radius>0.016</radius><length>0.001</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
        <visual name="socket_LCP">
          <pose>0.10 -0.08 0.006 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.001</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Black</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ========== PERCEPTION CAMERAS (4x depth, facing down) ========== -->
    <!-- Camera height Z=1.40, table surface ~1.02 → ~0.38m distance
         hfov=0.8 rad → covers ~0.33m horizontally across 640px → ~0.5mm/px
         Pose: roll=0, pitch=π/2 (look down -Z), yaw=0 -->

    <!-- Camera above Prusa MK3 (pick detection) -->
    <model name="cam_mk3">
      <static>true</static>
      <pose>-0.4 0 1.40 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
          <transparency>1.0</transparency>
        </visual>
        <sensor type="depth" name="depth_camera">
          <update_rate>15.0</update_rate>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>2.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>cam_mk3</namespace>
            </ros>
            <camera_name>cam_mk3</camera_name>
            <frame_name>cam_mk3_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Camera above Prusa MK4-1 (pick detection) -->
    <model name="cam_mk4_1">
      <static>true</static>
      <pose>0.4 0.4 1.40 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
          <transparency>1.0</transparency>
        </visual>
        <sensor type="depth" name="depth_camera">
          <update_rate>15.0</update_rate>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>2.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>cam_mk4_1</namespace>
            </ros>
            <camera_name>cam_mk4_1</camera_name>
            <frame_name>cam_mk4_1_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Camera above Prusa MK4-2 (pick detection) -->
    <model name="cam_mk4_2">
      <static>true</static>
      <pose>0.4 -0.4 1.40 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material>
          <transparency>1.0</transparency>
        </visual>
        <sensor type="depth" name="depth_camera">
          <update_rate>15.0</update_rate>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>2.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>cam_mk4_2</namespace>
            </ros>
            <camera_name>cam_mk4_2</camera_name>
            <frame_name>cam_mk4_2_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Camera above Assembly Board (placement verification + drop detection) -->
    <model name="cam_assembly">
      <static>true</static>
      <pose>0 0 1.40 0 1.5708 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.03 0.03 0.03</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
          <transparency>1.0</transparency>
        </visual>
        <sensor type="depth" name="depth_camera">
          <update_rate>15.0</update_rate>
          <camera>
            <horizontal_fov>0.8</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>2.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>cam_assembly</namespace>
            </ros>
            <camera_name>cam_assembly</camera_name>
            <frame_name>cam_assembly_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Prusa MK3 (Flat Mockup) on Left Side (-0.6, 0) -->
    <model name="prusa_mk3">
      <static>true</static>
      <pose>-0.4 0 1.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Prusa MK4-1 (Flat Mockup) on Right Side (0.6, 0.4) -->
    <model name="prusa_mk4_1">
      <static>true</static>
      <pose>0.4 0.4 1.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Prusa MK4-2 (Flat Mockup) on Right Side (0.6, -0.4) -->
    <model name="prusa_mk4_2">
      <static>true</static>
      <pose>0.4 -0.4 1.04 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.05</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==============================================
         PARTS: SMALL SET on MK3 (-0.6, 0.0)
         All components spawned at Z=1.15 to prevent clipping
         Friction reduced from mu=20 to mu=0.5 for slot insertion
         ============================================== -->
    <model name="gear_small">
      <pose>-0.4 0.1 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.016</radius><length>0.01</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.016</radius><length>0.01</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>
    <model name="rect_pin_small">
      <pose>-0.4 0.0 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.02 0.02 0.06</size></box></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.02 0.02 0.06</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
      </link>
    </model>
    <model name="circ_pin_small">
      <pose>-0.4 -0.1 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.01</radius><length>0.06</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.01</radius><length>0.06</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>

    <!-- ==============================================
         PARTS: MEDIUM SET on MK4-1 (0.6, 0.4)
         All components spawned at Z=1.15
         ============================================== -->
    <model name="gear_medium">
      <pose>0.4 0.5 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.10</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.024</radius><length>0.015</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.024</radius><length>0.015</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>
    <model name="rect_pin_medium">
      <pose>0.4 0.4 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.07</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.025 0.025 0.08</size></box></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.025 0.025 0.08</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
      </link>
    </model>
    <model name="circ_pin_medium">
      <pose>0.4 0.3 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.07</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.013</radius><length>0.08</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.013</radius><length>0.08</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>

    <!-- ==============================================
         PARTS: LARGE SET on MK4-2 (0.6, -0.4)
         All components spawned at Z=1.15
         ============================================== -->
    <model name="gear_large">
      <pose>0.4 -0.3 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.15</mass><inertia><ixx>0.0003</ixx><iyy>0.0003</iyy><izz>0.0003</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.032</radius><length>0.02</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.032</radius><length>0.02</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>
    <model name="rect_pin_large">
      <pose>0.4 -0.4 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.09</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.03 0.03 0.1</size></box></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><box><size>0.03 0.03 0.1</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
      </link>
    </model>
    <model name="circ_pin_large">
      <pose>0.4 -0.5 1.15 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.09</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.015</radius><length>0.10</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction>
            <contact><ode><kp>20000.0</kp><kd>8.0</kd><max_vel>0.05</max_vel><min_depth>0.0005</min_depth></ode></contact>
          </surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.015</radius><length>0.10</length></cylinder></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <!-- Re-enabling gravity to 9.81 so the objects can sit on the tables instead of flying -->
      <gravity>0 0 -9.81</gravity>
    </physics>

  </world>
</sdf>
