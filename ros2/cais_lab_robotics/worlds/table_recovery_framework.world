    <!-- Static straight pickup buffer; transport and occupancy follow later. -->
    <model name="Buffer For Machined parts">
      <static>true</static>
      <pose>-0.50 0.50 1.015 0 0 0</pose>
      <link name="link">
        <!-- Four direct-part accumulation zones. The shallow fixed channel
             supports horizontal pegs without removable carriers. -->
        <collision name="zone_1_belt"><pose>-.18 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry></collision>
        <visual name="zone_1_belt"><pose>-.18 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry><material><ambient>.12 .17 .20 1</ambient><diffuse>.12 .17 .20 1</diffuse></material></visual>
        <collision name="zone_2_belt"><pose>-.06 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry></collision>
        <visual name="zone_2_belt"><pose>-.06 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry><material><ambient>.20 .25 .28 1</ambient><diffuse>.20 .25 .28 1</diffuse></material></visual>
        <collision name="zone_3_belt"><pose>.06 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry></collision>
        <visual name="zone_3_belt"><pose>.06 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry><material><ambient>.12 .17 .20 1</ambient><diffuse>.12 .17 .20 1</diffuse></material></visual>
        <collision name="zone_4_belt"><pose>.18 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry></collision>
        <visual name="zone_4_belt"><pose>.18 0 0 0 0 0</pose><geometry><box><size>.119 .24 .004</size></box></geometry><material><ambient>.20 .25 .28 1</ambient><diffuse>.20 .25 .28 1</diffuse></material></visual>

        <collision name="guide_left"><pose>0 .019 .003 0.25 0 0</pose><geometry><box><size>.48 .012 .004</size></box></geometry></collision>
        <visual name="guide_left"><pose>0 .019 .003 0.25 0 0</pose><geometry><box><size>.48 .012 .004</size></box></geometry><material><ambient>.62 .68 .72 1</ambient><diffuse>.62 .68 .72 1</diffuse></material></visual>
        <collision name="guide_right"><pose>0 -.019 .003 -0.25 0 0</pose><geometry><box><size>.48 .012 .004</size></box></geometry></collision>
