<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- View from the front aisle: M1/M2 run left to right, with Assembly
         Station to their right. This does not change the perception cameras. -->
    <gui>
      <camera name="user_camera">
        <pose>-4.5 -9 11.0 0 0.80 1.57079632679</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <!-- Machining Station: M1 and M2 are side by side. Both front doors face
         ur5e-1 and ur5e-2. The side openings allow KMR loading. -->
    <include>
      <uri>model://bantam_tools_desktop_cnc</uri>
      <name>M1</name>
      <pose>-6.0 1.9 0.0 0.0 0.0 -1.5707963267948966</pose>
    </include>
    <include>
      <uri>model://bantam_tools_desktop_cnc</uri>
      <name>M2</name>
      <pose>-2.6 1.9 0.0 0.0 0.0 -1.5707963267948966</pose>
    </include>

    <model name="M1_KMR_docking_pose">
      <static>true</static>
      <pose>-6.85 2.15 0.004 0.0 0.0 1.5707963267948966</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.19 0.72 0.008</size></box></geometry>
          <material><ambient>0.10 0.35 0.80 0.45</ambient><diffuse>0.10 0.35 0.80 0.45</diffuse></material>
          <transparency>0.55</transparency>
        </visual>
      </link>
    </model>
    <!-- The launch replaces this appearance with the articulated KMR at the Storage dock. -->
    <include>
      <uri>model://KMR</uri>
      <name>KMR</name>
      <pose>-8.24 2.13 0.0 0.0 0.0 1.5707963267948966</pose>
    </include>
