{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Case 3 Bridge Dry-Run: Multi-Turn v2 (F5 Default)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/test_case3_bridge_dryrun.py",
            "args": [
                "--reasoning-mode",
                "multi_turn"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/scripts/ros_python.sh"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/scripts/ros_python.sh"
        }
    ]
}
