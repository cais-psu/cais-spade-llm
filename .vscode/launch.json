{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CAIS UI: Physical ur5e",
            "type": "debugpy",
            "request": "launch",
            "module": "cais_spade_llm.ui_main",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/scripts/ros_python.sh",
            "env": {
                "ROS_DOMAIN_ID": "42",
                "CAIS_SPADE_LLM_MODEL": "gpt-5.4",
                "CAIS_SPADE_REASONING_EFFORT": "low",
                "CAIS_SPADE_NON_FUNCTION_REASONING_EFFORT": "low"
            }
        },
        {
            "name": "Python: Current File (F5 Default)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/scripts/ros_python.sh",
            "env": {
                "ROS_DOMAIN_ID": "42",
                "CAIS_SPADE_LLM_MODEL": "gpt-5.4",
                "CAIS_SPADE_REASONING_EFFORT": "low",
                "CAIS_SPADE_NON_FUNCTION_REASONING_EFFORT": "low"
            }
        }
    ]
}
