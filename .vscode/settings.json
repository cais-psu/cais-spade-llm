{
    // Disable auto-activation of Poetry venv in NEW terminals
    // This prevents the .venv from being activated when you open a terminal
    "python.terminal.activateEnvironment": false,
    // BUT keep the venv active for F5 (Run/Debug) and Python language features
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    // Optional: create a ROS 2 terminal profile for convenience
    "terminal.integrated.profiles.linux": {
        "ROS 2": {
            "path": "/bin/bash",
            "args": [
                "-c",
                "source /opt/ros/humble/setup.bash && source ~/ros2_ws/install/setup.bash && exec bash"
            ],
            "icon": "robot"
        },
        "Python (SPADE)": {
            "path": "/bin/bash",
            "args": [
                "-c",
                "source ${workspaceFolder}/.venv/bin/activate && exec bash"
            ],
            "icon": "snake"
        }
    },
    "python-envs.defaultEnvManager": "ms-python.python:venv",
    "python-envs.defaultPackageManager": "ms-python.python:pip",
    "python.locator": "js"
}