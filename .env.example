# Required for LLM-backed planning and recovery flows.
OPENAI_API_KEY=

# Good defaults for a first UI run without ROS2 or physical robots.
ROBOT_ENV=gazebo
EXECUTION_MODE=dry_run
PERCEPTION_BACKEND=gazebo_gt

# Optional local SPADE/XMPP defaults.
CAIS_XMPP_HOST=localhost
CAIS_XMPP_DB_IN_MEMORY=1

# Optional ROS2 domain defaults used by digital twin processes.
ROS_DOMAIN_ID=0
CAIS_DIGITAL_TWIN_GAZEBO_DOMAIN_ID=41
CAIS_DIGITAL_TWIN_HARDWARE_DOMAIN_ID=42

# Wrist RealSense + Roboflow gear perception. Never commit the real key.
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://detect.roboflow.com
ROBOFLOW_MODEL_ID=hrc-assembly-gph6m/5
