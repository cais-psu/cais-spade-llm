{
  "rules": [
    {
      "id": "SAFE_1",
      "raw_text": "two robots should not place parts in the assembly board at the same time",
      "constraint_type": "no_concurrent_placement",
      "process": "assembly",
      "product": [],
      "resources": [
        "any"
      ],
      "event": "place_insert",
      "context": {
        "destination": "assembly_board-v1"
      },
      "aps": [
        {
          "label": "ap001",
          "full": "ap/assembly/any/ur5e/place_insert/destination_assembly_board-v1"
        },
        {
          "label": "ap002",
          "full": "ap/assembly/any/xarm6/place_insert/destination_assembly_board-v1"
        }
      ],
      "ltlf": "G !(ap001 & ap002)"
    }
  ]
}