digraph MONA_DFA {
 rankdir = LR;
 center = true;
 size = "7.5,10.5";
 edge [fontname = Courier];
 node [height = .5, width = .5];
 node [shape = doublecircle]; 1;
 node [shape = circle]; 1;
 init [shape = plaintext, label = ""];
 init -> 1;
 1 -> 1 [label="(~ap001 & ~ap002) | (~ap001 & ~ap004) | (~ap002 & ~ap003) | (~ap003 & ~ap004)"];
 1 -> 2 [label="(ap001 | ap002) & (ap001 | ap004) & (ap002 | ap003) & (ap003 | ap004)"];
 2 -> 2 [label="true"];
}