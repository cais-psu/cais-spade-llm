{
  "rules": [
    {
      "id": "SAFE_1",
      "raw_text": "MCP must be place_part to assembly_board-v1 before SG is place_part to assembly_board-v1 (ordering constraint)",
      "constraint_type": "ordering_constraint",
      "process": "assembly",
      "product": [
        "MCP",
        "SG"
      ],
      "resources": [
        "any"
      ],
      "event": null,
      "context": {
        "destination": "assembly_board-v1"
      },
      "aps": [
        {
          "label": "ap001",
          "full": "evt/assembly/MCP/any/place_part/assembly_board-v1"
        },
        {
          "label": "ap002",
          "full": "evt/assembly/SG/any/place_part/assembly_board-v1"
        }
      ],
      "ltlf": "(!ap002) U ap001"
    }
  ]
}