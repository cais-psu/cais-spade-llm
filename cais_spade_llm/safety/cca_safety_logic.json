  "rules": [
    {
      "id": "SAFE_shared_area_mutex",
      "raw_text": "At most one resource may occupy the assembly_board-v1 destination area at any time.",
      "aps": [
        {
          "label": "ap001",
          "full": "{\"kind\":\"ap_state\",\"process\":\"*\",\"product\":\"*\",\"resource\":\"$first_resource\",\"state\":{\"arguments\":{\"region\":\"$region\"},\"symbol\":\"any\"}}",
          "meaning": "The first bound resource's configured robot/tool geometry, including any carried part, touches or overlaps the bound shared area. A deposited part does not retain the resource's occupancy.",
          "definition": {
            "kind": "ap_state",
            "process": "*",
            "product": "*",
            "resource": "$first_resource",
            "state": {
              "arguments": {
                "region": "$region"
              },
              "symbol": "any"
            }
          }
        },
        {
          "label": "ap002",
          "full": "{\"kind\":\"ap_state\",\"process\":\"*\",\"product\":\"*\",\"resource\":\"$second_resource\",\"state\":{\"arguments\":{\"region\":\"$region\"},\"symbol\":\"any\"}}",
          "meaning": "The second bound resource's configured robot/tool geometry, including any carried part, touches or overlaps the bound shared area. A deposited part does not retain the resource's occupancy.",
          "definition": {
            "kind": "ap_state",
            "process": "*",
            "product": "*",
            "resource": "$second_resource",
            "state": {
              "arguments": {
                "region": "$region"
              },
              "symbol": "any"
            }
          }
        }
      ],
      "ltlf": "G !(ap001 & ap002)",
      "requirement_scopes": [
        {
          "specification": "SAFE_shared_area_mutex",
          "region": "assembly_board-v1"
        }
      ]
    },
    {
      "id": "SAFE_gear_small_before_KET4_Square_4mm",
      "raw_text": "KET4_Square_4mm may enter assembly_board-v1 only after assembly of gear_small is completed.",
      "aps": [
        {
          "label": "ap001",
          "full": "{\"event\":{\"arguments\":{\"region\":\"$region\"},\"symbol\":\"part_region_entry\"},\"kind\":\"ap_event\",\"process\":\"*\",\"product\":\"$part\",\"resource\":\"*\"}",
          "meaning": "The bound part begins touching or overlapping the bound region. Initial occupancy is not an entry; custody changes alone do not create entry.",
          "definition": {
            "event": {
              "arguments": {
                "region": "$region"
              },
              "symbol": "part_region_entry"
            },
            "kind": "ap_event",
            "process": "*",
            "product": "$part",
            "resource": "*"
          }
        },
        {
          "label": "ap002",
          "full": "{\"kind\":\"ap_state\",\"process\":\"$process\",\"product\":\"$part\",\"resource\":\"*\",\"state\":{\"arguments\":{\"target\":\"$target\"},\"symbol\":\"processCompleted\"}}",
          "meaning": "The bound part's explicitly complete processCompleted ledger contains the exact bound process and target record.",
          "definition": {
            "kind": "ap_state",
            "process": "$process",
            "product": "$part",
            "resource": "*",
            "state": {
              "arguments": {
                "target": "$target"
              },
              "symbol": "processCompleted"
            }
          }
        }
      ],
      "ltlf": "(!ap001 U (ap002 & !ap001)) | G !ap001",
      "requirement_scopes": [
        {
          "specification": "SAFE_gear_small_before_KET4_Square_4mm",
          "physical_ap_bindings": {
            "ap001": {
              "part": "KET4_Square_4mm",
              "region": "assembly_board-v1"
            },
            "ap002": {
              "part": "gear_small",
              "process": "assembly",
              "target": "Gear_Plate/Gear_Shaft_1"
            }
          }
        }
      ]
    }
  ],
