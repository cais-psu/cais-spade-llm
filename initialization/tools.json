      },
      "speed": {
        "type": "number",
        "description": "Optional motion speed."
      },
      "product_jid": {
        "type": "string",
        "description": "JID of the ProductAgent that owns this task."
      },
      "task_id": {
        "type": "string"
      }
    },
    "description": "Move empty gripper to the part's origin location."
  },
